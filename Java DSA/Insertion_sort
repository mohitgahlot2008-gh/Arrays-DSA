import java.util.*;
public class Main{
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int N= sc.nextInt();
        int[] A=new int[N];
        for (int i=0;i<N;i++){
            A[i]=sc.nextInt();
        }
        for (int i=1;i<A.length;i++) {
            int key=A[i];
            int j=i-1;
            while (j>=0 && A[j]>key) {
                A[j+1]=A[j];
                j--;
            }
            A[j+1]=key;
        }
        for (int i=0;i<N;i++) {
            System.out.print(A[i]);
            if (i<N-1){
                System.out.print(" ");
            }
        }
        System.out.println();
    }
}
